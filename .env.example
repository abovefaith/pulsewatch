# Copy to .env and adjust. Every variable is validated at startup (see src/config.ts).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Required: protects all write/admin endpoints. Generate one with:
#   node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
API_KEY=change-me-to-a-long-random-string

DATABASE_PATH=./data/pulsewatch.db
CHECK_CONCURRENCY=10
RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120

# Optional: when set, outgoing webhooks carry an HMAC-SHA256 signature header.
WEBHOOK_SECRET=
